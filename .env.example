PORT=5000
NODE_ENV=development

# Google Sheets Configuration
# Google Sheet ID can be found in the sheet URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEET_ID=
# Paste your Google Service Account JSON string here or configure it in the Settings page
GOOGLE_SERVICE_ACCOUNT_JSON=

# Gemini API Configuration
GEMINI_API_KEY=

# Email SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+918017129474

# LinkedIn OAuth Configuration
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/linkedin/callback
